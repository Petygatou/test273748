# Fonte de dados: auto (API oficial, cai para demonstração se falhar) | live | demo
DATA_MODE=auto
# CARTOLA_API_BASE=https://api.cartola.globo.com
# Simulações de Monte Carlo por rodada (reduza em hosts com pouca CPU)
SIMULATIONS=3000

# O Comandante (IA) — chave da API da Anthropic (somente servidor)
ANTHROPIC_API_KEY=

# Painel ADM sem Lovable Cloud: token exigido para editar prováveis escalações
ADMIN_TOKEN=

# Feeds RSS da Central de Notícias (separados por vírgula). Padrão: buscas do Google Notícias.
# NEWS_FEEDS=

# Lovable Cloud (Supabase) — habilita login, comunidade compartilhada, alertas e prováveis persistentes
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
