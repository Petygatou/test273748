# Fonte de dados: auto (API oficial, cai para demonstração se falhar) | live | demo
DATA_MODE=auto
# Hosts da API do Cartola, em ordem de preferência
# CARTOLA_API_HOSTS=https://api.cartolafc.globo.com,https://api.cartola.globo.com
# Simulações de Monte Carlo por rodada (reduza em hosts com pouca CPU)
SIMULATIONS=3000

# Pasta do banco, mídias e snapshots (faça backup)
DATA_DIR=./data
# Administradores (vírgula). Sem isso, a primeira conta criada vira administradora.
ADMIN_EMAILS=

# O Comandante (IA) — chave da API da Anthropic (somente servidor)
ANTHROPIC_API_KEY=

# Feeds RSS da Central de Notícias (separados por vírgula). Padrão: buscas do Google Notícias.
# NEWS_FEEDS=
